generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

model GuestbookEntry {
  id               String   @id @default(cuid())
  locale           String   @default("sr")
  name             String
  email            String?
  topic            String?
  type             String
  message          String   @db.Text
  publicConsent    Boolean  @default(false)
  moderationStatus String   @default("pending")
  moderationNotes  String?  @db.Text
  aiRiskFlags      Json?
  publishedName    String?
  publishedText    String?  @db.Text
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model SupportTicket {
  id           String   @id @default(cuid())
  locale       String   @default("sr")
  name         String?
  email        String?
  category     String
  message      String   @db.Text
  status       String   @default("open")
  aiSummary    String?  @db.Text
  aiReplyDraft String?  @db.Text
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model ContactMessage {
  id        String   @id @default(cuid())
  locale    String   @default("sr")
  name      String
  email     String
  subject   String?
  message   String   @db.Text
  status    String   @default("new")
  createdAt DateTime @default(now())
}

model NewsletterConsent {
  id        String   @id @default(cuid())
  email     String   @unique
  locale    String   @default("sr")
  source    String?
  consent   Boolean  @default(false)
  createdAt DateTime @default(now())
}
